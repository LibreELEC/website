---
import LibreElecLogo from './LibreElecLogo.astro';
import { getDownloadConfig } from '../utils/downloads';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const downloadsUrl = `${base}/downloads/`;
const config = getDownloadConfig();
const creator = config.creator;
const creatorVersion = creator?.version || '1.6';
const windowsUrl = creator?.downloads?.windows?.url || "https://releases.libreelec.tv/LibreELEC.USB-SD.Creator.Win32.exe";
const macosUrl = creator?.downloads?.macos?.url || "https://releases.libreelec.tv/LibreELEC.USB-SD.Creator.macOS.dmg";
const linuxUrl = creator?.downloads?.linux?.url || "https://releases.libreelec.tv/LibreELEC.USB-SD.Creator.Linux-64bit.AppImage";
---
<section id="creator" class="py-20 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="glass-card rounded-3xl p-8 sm:p-12 border border-slate-200 dark:border-slate-800 relative">
            <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-brand-500/10 rounded-full blur-3xl pointer-events-none"></div>
            
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
                <div>
                    <span class="text-xs font-bold text-brand-600 dark:text-brand-400 uppercase tracking-widest mb-2 block">Official Installation App</span>
                    <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white mb-4 leading-tight">
                        LibreELEC USB-SD Creator
                    </h2>
                    <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed mb-6">
                        Don't want to manually extract `.img.gz` files? Download our cross-platform utility tool to select your target hardware, automatically fetch the latest release, and write it to your USB drive or SD card in 3 simple clicks.
                    </p>

                    <!-- Creator Steps -->
                    <div class="space-y-4 mb-8">
                        <div class="flex items-start gap-4">
                            <div class="w-7 h-7 rounded-full bg-brand-50 dark:bg-brand-500/15 border border-brand-200 dark:border-brand-500/30 text-brand-600 dark:text-brand-400 flex items-center justify-center font-bold text-xs shrink-0 mt-0.5">1</div>
                            <p class="text-xs sm:text-sm text-slate-700 dark:text-slate-300"><strong class="text-slate-900 dark:text-white">Choose hardware:</strong> Pick your Raspberry Pi model or x86 system from the dropdown menu.</p>
                        </div>
                        <div class="flex items-start gap-4">
                            <div class="w-7 h-7 rounded-full bg-brand-50 dark:bg-brand-500/15 border border-brand-200 dark:border-brand-500/30 text-brand-600 dark:text-brand-400 flex items-center justify-center font-bold text-xs shrink-0 mt-0.5">2</div>
                            <p class="text-xs sm:text-sm text-slate-700 dark:text-slate-300"><strong class="text-slate-900 dark:text-white">Select destination:</strong> Plug in your USB flash stick or SD card reader.</p>
                        </div>
                        <div class="flex items-start gap-4">
                            <div class="w-7 h-7 rounded-full bg-brand-50 dark:bg-brand-500/15 border border-brand-200 dark:border-brand-500/30 text-brand-600 dark:text-brand-400 flex items-center justify-center font-bold text-xs shrink-0 mt-0.5">3</div>
                            <p class="text-xs sm:text-sm text-slate-700 dark:text-slate-300"><strong class="text-slate-900 dark:text-white">Write & Boot:</strong> Hit "Write" and plug it directly into your HTPC!</p>
                        </div>
                    </div>

                    <!-- Creator OS Buttons -->
                    <div class="flex flex-wrap items-center gap-3">
                        <a href={windowsUrl} class="px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 dark:bg-slate-800 dark:hover:bg-slate-700 dark:border dark:border-slate-700 text-white font-semibold text-xs shadow-sm flex items-center gap-2 transition-all">
                            <i class="fa-brands fa-windows text-blue-400"></i> Windows (.exe)
                        </a>
                        <a href={macosUrl} class="px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 dark:bg-slate-800 dark:hover:bg-slate-700 dark:border dark:border-slate-700 text-white font-semibold text-xs shadow-sm flex items-center gap-2 transition-all">
                            <i class="fa-brands fa-apple text-slate-300"></i> macOS (.dmg)
                        </a>
                        <a href={linuxUrl} class="px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 dark:bg-slate-800 dark:hover:bg-slate-700 dark:border dark:border-slate-700 text-white font-semibold text-xs shadow-sm flex items-center gap-2 transition-all">
                            <i class="fa-brands fa-linux text-amber-400"></i> Linux (.AppImage)
                        </a>
                    </div>

                    <!-- Link to Manual Download Site -->
                    <div class="mt-6 pt-4 border-t border-slate-100 dark:border-slate-800">
                        <a href={downloadsUrl} class="inline-flex items-center gap-1.5 text-xs font-semibold text-brand-600 dark:text-brand-400 hover:text-brand-700 dark:hover:text-brand-300 hover:underline">
                            Looking for manual disk images (.img.gz) or older releases? Visit our Download Hub &rarr;
                        </a>
                    </div>
                </div>

                <!-- App UI Graphic Mockup -->
                <div class="relative max-w-[410px] mx-auto w-full">
                    <div class="rounded-2xl border border-slate-300 dark:border-slate-700 shadow-2xl bg-[#f0f2f5] dark:bg-slate-900 overflow-hidden font-sans select-none text-slate-800 dark:text-slate-200">
                        <!-- Windows Titlebar -->
                        <div class="flex items-center justify-between px-2.5 py-1 bg-[#fbfcfd] dark:bg-slate-950 border-b border-slate-200 dark:border-slate-800">
                            <div class="flex items-center gap-1.5">
                                <LibreElecLogo class="w-3 h-3" />
                                <span class="text-[11px] text-slate-800 dark:text-slate-200 font-normal">LibreELEC USB-SD Creator</span>
                            </div>
                            <div class="flex items-center text-slate-500 dark:text-slate-400">
                                <span class="w-6 h-4 flex items-center justify-center text-[9px]"><i class="fa-solid fa-minus"></i></span>
                                <span class="w-6 h-4 flex items-center justify-center text-[9px]"><i class="fa-regular fa-square"></i></span>
                                <span class="w-6 h-4 flex items-center justify-center text-[10px]"><i class="fa-solid fa-xmark"></i></span>
                            </div>
                        </div>

                        <!-- App Body -->
                        <div class="p-3 space-y-2.5">
                            <!-- Banner -->
                            <div class="relative bg-black rounded-lg p-2.5 sm:p-3 flex items-center justify-between overflow-hidden shadow-inner">
                                <div class="flex items-center gap-2.5 sm:gap-3">
                                    <div class="w-10 h-10 sm:w-11 sm:h-11 shrink-0 flex items-center justify-center">
                                        <LibreElecLogo class="w-full h-full" dropShadow={true} />
                                    </div>
                                    <div class="flex flex-col">
                                        <span class="text-lg sm:text-xl font-black text-white tracking-tight leading-none mb-0.5">
                                            LibreELEC
                                        </span>
                                        <span class="text-[11px] sm:text-xs font-semibold text-slate-400 tracking-wide">
                                            Just enough OS for KODI
                                        </span>
                                    </div>
                                </div>
                                <!-- Language / UK Flag -->
                                <div class="absolute bottom-1.5 right-2">
                                    <svg class="w-3.5 h-2 rounded-[1px] shadow-sm" viewBox="0 0 60 30" aria-label="English">
                                        <clipPath id="uk-flag">
                                            <rect width="60" height="30"/>
                                        </clipPath>
                                        <g clip-path="url(#uk-flag)">
                                            <rect width="60" height="30" fill="#012169"/>
                                            <path d="M0 0 L60 30 M60 0 L0 30" stroke="#fff" stroke-width="6"/>
                                            <path d="M0 0 L60 30 M60 0 L0 30" stroke="#C8102E" stroke-width="4"/>
                                            <path d="M30 0 v30 M0 15 h60" stroke="#fff" stroke-width="10"/>
                                            <path d="M30 0 v30 M0 15 h60" stroke="#C8102E" stroke-width="6"/>
                                        </g>
                                    </svg>
                                </div>
                            </div>

                            <!-- Step 1: Select version -->
                            <div class="space-y-1">
                                <div class="flex items-center justify-between text-[11px]">
                                    <div class="flex items-center gap-1.5 font-semibold text-slate-800 dark:text-slate-100">
                                        <span class="w-4 h-4 rounded-full bg-amber-500 text-white flex items-center justify-center text-[10px] font-bold shrink-0">1</span>
                                        <span>Select version</span>
                                    </div>
                                    <label class="flex items-center gap-1 text-[11px] text-slate-700 dark:text-slate-300 cursor-default">
                                        <span><span class="underline">S</span>how all</span>
                                        <input type="checkbox" disabled class="w-3 h-3 rounded border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 pointer-events-none" />
                                    </label>
                                </div>
                                <div class="grid grid-cols-1 sm:grid-cols-12 gap-1.5 text-[11px]">
                                    <div class="sm:col-span-5 px-2 py-1 rounded bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 flex items-center justify-between shadow-sm">
                                        <span class="font-medium text-slate-800 dark:text-slate-200">Raspberry Pi 5</span>
                                        <i class="fa-solid fa-caret-down text-slate-500 text-[9px]"></i>
                                    </div>
                                    <div class="sm:col-span-7 px-2 py-1 rounded bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 flex items-center justify-between shadow-sm min-w-0">
                                        <span class="font-medium text-slate-800 dark:text-slate-200 truncate">LibreELEC-RPi5.aarch64-12.2.1.img.gz, 156 MB</span>
                                        <i class="fa-solid fa-caret-down text-slate-500 text-[9px] ml-1 shrink-0"></i>
                                    </div>
                                </div>
                            </div>

                            <!-- Step 2: Download or select a local image file -->
                            <div class="space-y-1">
                                <div class="flex items-center gap-1.5 text-[11px] font-semibold text-slate-800 dark:text-slate-100">
                                    <span class="w-4 h-4 rounded-full bg-rose-500 text-white flex items-center justify-center text-[10px] font-bold shrink-0">2</span>
                                    <span>Download or select a local image file</span>
                                </div>
                                <div class="px-2 py-0.5 rounded bg-slate-200/70 dark:bg-slate-800/60 border border-slate-300 dark:border-slate-600 text-[11px] text-slate-800 dark:text-slate-200">
                                    Download complete, checksum ok.
                                </div>
                                <div class="flex items-center gap-1.5">
                                    <button type="button" class="px-3 py-0.5 rounded bg-white hover:bg-slate-50 dark:bg-slate-800 dark:hover:bg-slate-700 border border-slate-300 dark:border-slate-600 text-[11px] font-medium text-slate-800 dark:text-slate-200 shadow-sm">
                                        <span class="underline">D</span>ownload
                                    </button>
                                    <button type="button" class="px-3 py-0.5 rounded bg-white hover:bg-slate-50 dark:bg-slate-800 dark:hover:bg-slate-700 border border-slate-300 dark:border-slate-600 text-[11px] font-medium text-slate-800 dark:text-slate-200 shadow-sm">
                                        Select <span class="underline">f</span>ile
                                    </button>
                                </div>
                                <div class="px-2 py-0.5 rounded bg-slate-200/70 dark:bg-slate-800/60 border border-slate-300 dark:border-slate-600 text-[11px] text-slate-800 dark:text-slate-200 truncate">
                                    C:/Users/kodi/Downloads/LibreELEC-RPi5.aarch64-12.2.1.img.gz
                                </div>
                            </div>

                            <!-- Step 3: Select your USB stick or SD card -->
                            <div class="space-y-1">
                                <div class="flex items-center gap-1.5 text-[11px] font-semibold text-slate-800 dark:text-slate-100">
                                    <span class="w-4 h-4 rounded-full bg-sky-500 text-white flex items-center justify-center text-[10px] font-bold shrink-0">3</span>
                                    <span>Select your USB stick or SD card</span>
                                </div>
                                <div class="flex items-center gap-1.5 text-[11px]">
                                    <div class="flex-1 px-2 py-1 rounded bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 flex items-center justify-between shadow-sm">
                                        <span class="font-medium text-slate-800 dark:text-slate-200">D:\ [16 GB]</span>
                                        <i class="fa-solid fa-caret-down text-slate-500 text-[9px]"></i>
                                    </div>
                                    <button type="button" class="w-6 h-6 rounded bg-white hover:bg-slate-50 dark:bg-slate-800 dark:hover:bg-slate-700 border border-slate-300 dark:border-slate-600 flex items-center justify-center text-sky-600 dark:text-sky-400 shadow-sm shrink-0" title="Refresh drives">
                                        <i class="fa-solid fa-rotate-right text-[10px]"></i>
                                    </button>
                                </div>
                            </div>

                            <!-- Step 4: Write image -->
                            <div class="space-y-1">
                                <div class="flex items-center gap-1.5 text-[11px] font-semibold text-slate-800 dark:text-slate-100">
                                    <span class="w-4 h-4 rounded-full bg-emerald-500 text-white flex items-center justify-center text-[10px] font-bold shrink-0">4</span>
                                    <span>Write image</span>
                                </div>
                                <div>
                                    <button type="button" class="px-5 py-0.5 rounded bg-white hover:bg-slate-50 dark:bg-slate-800 dark:hover:bg-slate-700 border border-slate-300 dark:border-slate-600 text-[11px] font-medium text-slate-800 dark:text-slate-200 shadow-sm">
                                        <span class="underline">W</span>rite
                                    </button>
                                </div>
                                <div class="w-full h-4 rounded bg-slate-200/70 dark:bg-slate-800/60 border border-slate-300 dark:border-slate-600"></div>
                            </div>

                            <!-- Bottom Action Buttons -->
                            <div class="flex items-center justify-between pt-1.5">
                                <button type="button" class="px-4 py-0.5 rounded bg-white hover:bg-slate-50 dark:bg-slate-800 dark:hover:bg-slate-700 border border-slate-300 dark:border-slate-600 text-[11px] font-medium text-slate-800 dark:text-slate-200 shadow-sm">
                                    About
                                </button>
                                <div class="flex items-center gap-1.5">
                                    <button type="button" class="px-4 py-0.5 rounded bg-white hover:bg-slate-50 dark:bg-slate-800 dark:hover:bg-slate-700 border border-slate-300 dark:border-slate-600 text-[11px] font-medium text-slate-800 dark:text-slate-200 shadow-sm">
                                        Help
                                    </button>
                                    <button type="button" class="px-4 py-0.5 rounded bg-white hover:bg-slate-50 dark:bg-slate-800 dark:hover:bg-slate-700 border border-slate-300 dark:border-slate-600 text-[11px] font-medium text-slate-800 dark:text-slate-200 shadow-sm">
                                        Close
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
